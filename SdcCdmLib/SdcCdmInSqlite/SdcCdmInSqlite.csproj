<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\database\schemas\**\ddl\sqlite\*.sql" Link="database\schemas\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\database\etl\sqlite\*.sql" Link="database\etl\sqlite\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
    <!-- Pinned ahead of what Microsoft.Data.Sqlite 10.0.10 resolves (2.1.11) to
         clear GHSA-2m69-gcr7-jv3q. Drop once Microsoft.Data.Sqlite ships 2.1.12. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SdcCdm\SdcCdm.csproj" />
  </ItemGroup>

</Project>
