<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\database\schemas\**\ddl\sqlite\*.sql" Link="database\schemas\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\database\etl\sqlite\*.sql" Link="database\etl\sqlite\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
    <!-- CVE-2025-6965 / GHSA-2m69-gcr7-jv3q (high) covers SQLitePCLRaw <= 2.1.11.
         Microsoft.Data.Sqlite 10.0.10 resolves 2.1.11, which bundles SQLite 3.49.1;
         the CVE is fixed in SQLite 3.50.2 and 2.1.12 bundles 3.53.3. The advisory
         lists no patched package version, so pin explicitly rather than relying on
         the range. Drop once Microsoft.Data.Sqlite resolves 2.1.12 or later. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SdcCdm\SdcCdm.csproj" />
  </ItemGroup>

</Project>
