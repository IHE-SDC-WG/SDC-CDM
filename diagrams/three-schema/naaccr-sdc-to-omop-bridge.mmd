erDiagram
  %% Manifest bridge through Phase 4.2, both SQLite and SQL Server.
  %% Source: database/etl/{sqlite,sqlserver}/{1_person_and_period,2_note}.sql
  %% Solid (--) = enforced FK; dotted (..) = logical cross-schema reference.
  %% No repository-specific columns are added to stock OMOP.
  %% Every selected group has one note; accession alone is never an identity key.
  %% Anchor order: synoptic, other non-narrative, narrative; lowest report ID wins ties.
  %% Text: first non-empty selected narrative, anchor text, report-kind placeholder.
  %% Date: earliest anchor value observation day, then anchor envelope report day.
  %% Required dates and accession length are checked before note writes.
  %% Late complementary reports retain note_id and reconcile contributors + anchor.
  %% Supersession of a bridged group refreshes the full bridge atomically with selection.
  %% Measurements and observations are added in Phase 4.3. The excluded pre-rebuild
  %% bridge is tested separately and must not run on this bridge's database.

  INTAKE_PATIENT {
    INTEGER patient_id PK
    TEXT person_source_value
  }
  INTAKE_INBOUND_MESSAGE {
    INTEGER inbound_message_id PK
    BLOB raw_blob
  }
  INTAKE_INBOUND_ENVELOPE {
    INTEGER inbound_envelope_id PK
    INTEGER inbound_message_id FK
    TEXT envelope_json
  }
  NAACCR_REPORT_GROUP {
    INTEGER report_group_id PK
    INTEGER person_id
    TEXT sending_facility
    TEXT report_accession
  }
  NAACCR_REPORT_VERSION {
    INTEGER sdc_report_id UK
    INTEGER report_group_id FK
    TEXT report_loinc
    INTEGER is_selected
    INTEGER predecessor_sdc_report_id
  }
  SDC_REPORT {
    INTEGER sdc_report_id PK
    INTEGER person_id
    INTEGER inbound_envelope_id
    TEXT report_loinc
    TEXT report_text
  }
  NAACCR_VALUE {
    INTEGER naaccr_value_id PK
    INTEGER sdc_report_id
    TEXT observation_date
  }
  SDC_NOTE_REPORT {
    INTEGER note_id PK
    INTEGER sdc_report_id PK,FK,UK
    INTEGER report_group_id
    INTEGER is_anchor
  }
  OMOP_PERSON {
    INTEGER person_id PK
  }
  OMOP_NOTE {
    INTEGER note_id PK
    INTEGER person_id FK
    TEXT note_date
    TEXT note_text
    TEXT note_source_value
    INTEGER note_type_concept_id
  }
  ETL_CONCEPT_CONSTANT {
    TEXT constant_name PK
    INTEGER concept_id
  }

  INTAKE_PATIENT ||..|| OMOP_PERSON : "patient_id = person_id"
  INTAKE_PATIENT ||..o{ NAACCR_REPORT_GROUP : "person_id"
  NAACCR_REPORT_GROUP ||--|{ NAACCR_REPORT_VERSION : "report_group_id"
  SDC_REPORT ||..|| NAACCR_REPORT_VERSION : "sdc_report_id"
  SDC_REPORT ||..o{ NAACCR_VALUE : "sdc_report_id"
  INTAKE_INBOUND_MESSAGE ||--|{ INTAKE_INBOUND_ENVELOPE : "inbound_message_id"
  INTAKE_INBOUND_ENVELOPE ||..|| SDC_REPORT : "inbound_envelope_id"
  OMOP_PERSON ||--o{ OMOP_NOTE : "person_id"
  OMOP_NOTE ||..|{ SDC_NOTE_REPORT : "note_id (stable across refreshes)"
  SDC_REPORT ||--o| SDC_NOTE_REPORT : "selected contributors only"
  NAACCR_REPORT_GROUP ||..|{ SDC_NOTE_REPORT : "report_group_id (one anchor)"
  ETL_CONCEPT_CONSTANT ||..o{ OMOP_NOTE : "note_type_ehr and unmapped"
