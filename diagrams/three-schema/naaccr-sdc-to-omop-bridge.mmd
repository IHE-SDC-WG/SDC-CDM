erDiagram
  %% Manifest bridge (Phase 4), both SQLite and SQL Server.
  %% Source: database/etl/{sqlite,sqlserver}/{1_person_and_period,2_note,3_measurement_observation,4_condition_and_episode}.sql
  %% Solid (--) = enforced FK; dotted (..) = logical cross-schema reference.
  %% No repository-specific columns are added to stock OMOP.
  %% Every selected group has one note; accession alone is never an identity key.
  %% Anchor order: synoptic, other non-narrative, narrative; lowest report ID wins ties.
  %% Text: first non-empty selected narrative, anchor text, report-kind placeholder.
  %% Date: earliest anchor value observation day, then anchor envelope report day.
  %% Required dates and accession length are checked before note writes.
  %% Late complementary reports retain note_id and reconcile contributors + anchor.
  %% Supersession of a bridged group refreshes the full bridge atomically with selection.
  %% Every value of a selected report is one measurement or observation, linked by
  %% naaccr.value_event. Measurement/Observation-domain targets pick their table; any
  %% other value has concept 0 and goes to observation when it has text, else measurement.
  %% Maps join on item_num only; ecp_code is never parsed. #100 collision codes get no
  %% value_as_concept_id. Date: value day, then its report's day; neither fails the run.
  %% Each selected group with a primary-site (item 400) value has one thin condition from
  %% its lowest non-blank one, linked by naaccr.group_condition; condition_concept_id is a
  %% standard Condition target only, else 0. Each (person, episode_key) has one disease
  %% episode, linked by naaccr.person_episode, whose episode_event rows name every
  %% measurement, observation, and condition of that tumor.
  %% 9_validate.sql (sdc-cdm validate) reads every table here and writes nothing.

  INTAKE_PATIENT {
    INTEGER patient_id PK
    TEXT person_source_value
  }
  INTAKE_INBOUND_MESSAGE {
    INTEGER inbound_message_id PK
    BLOB raw_blob
  }
  INTAKE_INBOUND_ENVELOPE {
    INTEGER inbound_envelope_id PK
    INTEGER inbound_message_id FK
    TEXT envelope_json
  }
  NAACCR_REPORT_GROUP {
    INTEGER report_group_id PK
    INTEGER person_id
    TEXT sending_facility
    TEXT report_accession
  }
  NAACCR_REPORT_VERSION {
    INTEGER sdc_report_id UK
    INTEGER report_group_id FK
    TEXT report_loinc
    INTEGER is_selected
    INTEGER predecessor_sdc_report_id
  }
  SDC_REPORT {
    INTEGER sdc_report_id PK
    INTEGER person_id
    INTEGER inbound_envelope_id
    TEXT report_loinc
    TEXT report_text
  }
  NAACCR_VALUE {
    INTEGER naaccr_value_id PK
    INTEGER sdc_report_id
    INTEGER inbound_envelope_id
    INTEGER item_num
    TEXT ecp_code
    TEXT value_code
    REAL value_num
    TEXT value_text
    TEXT observation_date
  }
  NAACCR_VALUE_EVENT {
    INTEGER naaccr_value_id PK,FK
    TEXT event_table UK
    INTEGER event_id UK
    TEXT route
    TEXT value_target
    INTEGER is_truncated
  }
  NAACCR_CONCEPT_MAP {
    INTEGER item_num PK
    INTEGER source_concept_id
    INTEGER concept_id
    TEXT target_domain_id
  }
  NAACCR_VALUE_CONCEPT_MAP {
    INTEGER item_num PK
    TEXT code PK
    INTEGER concept_id
  }
  NAACCR_VALUE_CODE_COLLISION {
    INTEGER item_num
    TEXT code
  }
  SDC_NOTE_REPORT {
    INTEGER note_id PK
    INTEGER sdc_report_id PK,FK,UK
    INTEGER report_group_id
    INTEGER is_anchor
  }
  OMOP_PERSON {
    INTEGER person_id PK
  }
  OMOP_NOTE {
    INTEGER note_id PK
    INTEGER person_id FK
    TEXT note_date
    TEXT note_text
    TEXT note_source_value
    INTEGER note_type_concept_id
  }
  OMOP_MEASUREMENT {
    INTEGER measurement_id PK
    INTEGER person_id FK
    INTEGER measurement_concept_id
    INTEGER measurement_source_concept_id
    TEXT measurement_source_value
    REAL value_as_number
    INTEGER value_as_concept_id
    TEXT value_source_value
    TEXT unit_source_value
    INTEGER measurement_event_id
    INTEGER meas_event_field_concept_id
  }
  OMOP_OBSERVATION {
    INTEGER observation_id PK
    INTEGER person_id FK
    INTEGER observation_concept_id
    INTEGER observation_source_concept_id
    TEXT observation_source_value
    REAL value_as_number
    TEXT value_as_string
    INTEGER value_as_concept_id
    TEXT value_source_value
    TEXT unit_source_value
    INTEGER observation_event_id
    INTEGER obs_event_field_concept_id
  }
  NAACCR_GROUP_CONDITION {
    INTEGER report_group_id PK,FK
    INTEGER condition_occurrence_id UK
    INTEGER naaccr_value_id FK
    TEXT condition_target
  }
  NAACCR_PERSON_EPISODE {
    INTEGER episode_id PK
    INTEGER person_id UK
    TEXT episode_key UK
  }
  OMOP_CONDITION_OCCURRENCE {
    INTEGER condition_occurrence_id PK
    INTEGER person_id FK
    INTEGER condition_concept_id
    TEXT condition_start_date
    INTEGER condition_type_concept_id
    TEXT condition_source_value
    INTEGER condition_source_concept_id
  }
  OMOP_EPISODE {
    INTEGER episode_id PK
    INTEGER person_id FK
    INTEGER episode_concept_id
    TEXT episode_start_date
    INTEGER episode_object_concept_id
    INTEGER episode_type_concept_id
    INTEGER episode_source_concept_id
  }
  OMOP_EPISODE_EVENT {
    INTEGER episode_id FK
    INTEGER event_id
    INTEGER episode_event_field_concept_id
  }
  ETL_CONCEPT_CONSTANT {
    TEXT constant_name PK
    INTEGER concept_id
  }

  INTAKE_PATIENT ||..|| OMOP_PERSON : "patient_id = person_id"
  INTAKE_PATIENT ||..o{ NAACCR_REPORT_GROUP : "person_id"
  NAACCR_REPORT_GROUP ||--|{ NAACCR_REPORT_VERSION : "report_group_id"
  SDC_REPORT ||..|| NAACCR_REPORT_VERSION : "sdc_report_id"
  SDC_REPORT ||..o{ NAACCR_VALUE : "sdc_report_id"
  INTAKE_INBOUND_MESSAGE ||--|{ INTAKE_INBOUND_ENVELOPE : "inbound_message_id"
  INTAKE_INBOUND_ENVELOPE ||..|| SDC_REPORT : "inbound_envelope_id"
  OMOP_PERSON ||--o{ OMOP_NOTE : "person_id"
  OMOP_NOTE ||..|{ SDC_NOTE_REPORT : "note_id (stable across refreshes)"
  SDC_REPORT ||--o| SDC_NOTE_REPORT : "selected contributors only"
  NAACCR_REPORT_GROUP ||..|{ SDC_NOTE_REPORT : "report_group_id (one anchor)"
  ETL_CONCEPT_CONSTANT ||..o{ OMOP_NOTE : "note_type_ehr and unmapped"
  NAACCR_VALUE ||--o| NAACCR_VALUE_EVENT : "selected values only"
  NAACCR_VALUE_EVENT |o..|| OMOP_MEASUREMENT : "event_table = measurement"
  NAACCR_VALUE_EVENT |o..|| OMOP_OBSERVATION : "event_table = observation"
  NAACCR_CONCEPT_MAP ||..o{ NAACCR_VALUE : "item_num (route, both slots)"
  NAACCR_VALUE_CONCEPT_MAP ||..o{ NAACCR_VALUE : "(item_num, value_code)"
  NAACCR_VALUE_CODE_COLLISION ||..o{ NAACCR_VALUE : "suppresses value_as_concept_id"
  OMOP_PERSON ||--o{ OMOP_MEASUREMENT : "person_id"
  OMOP_PERSON ||--o{ OMOP_OBSERVATION : "person_id"
  OMOP_NOTE ||..o{ OMOP_MEASUREMENT : "measurement_event_id"
  OMOP_NOTE ||..o{ OMOP_OBSERVATION : "observation_event_id"
  ETL_CONCEPT_CONSTANT ||..o{ OMOP_MEASUREMENT : "type, field_note_note_id, unmapped"
  ETL_CONCEPT_CONSTANT ||..o{ OMOP_OBSERVATION : "type, field_note_note_id, unmapped"
  NAACCR_REPORT_GROUP ||--o| NAACCR_GROUP_CONDITION : "groups with a site value"
  NAACCR_VALUE ||--o{ NAACCR_GROUP_CONDITION : "chosen item 400 value"
  NAACCR_GROUP_CONDITION ||..|| OMOP_CONDITION_OCCURRENCE : "condition_occurrence_id"
  NAACCR_VALUE_CONCEPT_MAP ||..o{ NAACCR_GROUP_CONDITION : "(400, value_code)"
  OMOP_PERSON ||--o{ OMOP_CONDITION_OCCURRENCE : "person_id"
  NAACCR_VALUE }o..|| NAACCR_PERSON_EPISODE : "(person_id, episode_key)"
  NAACCR_PERSON_EPISODE ||..|| OMOP_EPISODE : "episode_id"
  OMOP_PERSON ||--o{ OMOP_EPISODE : "person_id"
  OMOP_EPISODE ||--|{ OMOP_EPISODE_EVENT : "episode_id"
  OMOP_EPISODE_EVENT }o..o| OMOP_MEASUREMENT : "field_measurement_measurement_id"
  OMOP_EPISODE_EVENT }o..o| OMOP_OBSERVATION : "field_observation_observation_id"
  OMOP_EPISODE_EVENT }o..o| OMOP_CONDITION_OCCURRENCE : "field_condition_occurrence_id"
  ETL_CONCEPT_CONSTANT ||..o{ OMOP_CONDITION_OCCURRENCE : "condition_type_registry, unmapped"
  ETL_CONCEPT_CONSTANT ||..o{ OMOP_EPISODE : "episode_disease, episode_type_registry"
